#include <Arduino.h>
#include <SimpleFOC.h>
#include <Wire.h>

// =============================================================================
// AS5600 Magnetic Encoder Diagnostic (Pure Hardware I2C - No Bit-Banging)
// =============================================================================
MagneticSensorI2C sensor = MagneticSensorI2C(AS5600_I2C);

struct AS5600Diagnostics {
    bool i2c_ok;
    uint8_t wire_error;
    uint8_t status_raw;
    bool magnet_detected;    // MD bit 5
    bool magnet_too_weak;     // ML bit 4
    bool magnet_too_strong;   // MH bit 3
    uint8_t agc;             // AGC register 0x1A (0-255)
    uint16_t raw_angle;      // Registers 0x0C & 0x0D (12-bit: 0-4095)
    float raw_angle_deg;     // 0.0 to 359.9 deg
};

AS5600Diagnostics readAS5600() {
    AS5600Diagnostics diag = {false, 0, 0, false, false, false, 0, 0, 0.0f};

    // 1. Read STATUS register (0x0B)
    Wire.beginTransmission(0x36);
    Wire.write(0x0B);
    diag.wire_error = Wire.endTransmission(false);
    if (diag.wire_error != 0) {
        return diag;
    }
    if (Wire.requestFrom((uint8_t)0x36, (uint8_t)1) == 1) {
        diag.status_raw = Wire.read();
        diag.magnet_detected   = (diag.status_raw & 0x20) != 0;
        diag.magnet_too_weak   = (diag.status_raw & 0x10) != 0;
        diag.magnet_too_strong = (diag.status_raw & 0x08) != 0;
    } else {
        diag.wire_error = 0xFE;
        return diag;
    }

    // 2. Read RAW ANGLE registers (0x0C MSB, 0x0D LSB)
    Wire.beginTransmission(0x36);
    Wire.write(0x0C);
    diag.wire_error = Wire.endTransmission(false);
    if (diag.wire_error != 0) {
        return diag;
    }
    if (Wire.requestFrom((uint8_t)0x36, (uint8_t)2) == 2) {
        uint8_t msb = Wire.read();
        uint8_t lsb = Wire.read();
        diag.raw_angle = ((uint16_t)(msb & 0x0F) << 8) | lsb;
        diag.raw_angle_deg = (float)diag.raw_angle * 360.0f / 4096.0f;
    } else {
        diag.wire_error = 0xFE;
        return diag;
    }

    // 3. Read AGC register (0x1A)
    Wire.beginTransmission(0x36);
    Wire.write(0x1A);
    diag.wire_error = Wire.endTransmission(false);
    if (diag.wire_error == 0 && Wire.requestFrom((uint8_t)0x36, (uint8_t)1) == 1) {
        diag.agc = Wire.read();
    }

    diag.i2c_ok = true;
    return diag;
}

void setup() {
    pinMode(LED_BUILTIN, OUTPUT);
    digitalWrite(LED_BUILTIN, HIGH);

    Serial.begin(115200);
    delay(1000);

    Serial.println("\n=============================================");
    Serial.println("   B-G431B-ESC1 Hardware I2C Verification    ");
    Serial.println("   Testing Pad 2 (PB7 SDA) + Pad 3 (PB8 SCL) ");
    Serial.println("=============================================");

    Wire.setSCL(PB8);
    Wire.setSDA(PB7);
    Wire.setClock(400000);
    Wire.begin();

    sensor.init(&Wire);
}

void loop() {
    // Primary Test: Hardware Wire on PB8 (SCL) and PB7 (SDA)
    Wire.end();
    Wire.setSCL(PB8);
    Wire.setSDA(PB7);
    Wire.setClock(400000);
    Wire.begin();

    Wire.beginTransmission(0x36);
    byte err_pb8 = Wire.endTransmission();

    if (err_pb8 == 0) {
        AS5600Diagnostics diag = readAS5600();
        sensor.update();
        float foc_deg = sensor.getAngle() * 180.0f / PI;

        Serial.print("[PB8 SCL / PB7 SDA OK] Magnet: ");
        if (diag.magnet_detected) {
            Serial.print("DETECTED (MD=1)");
            if (diag.magnet_too_weak) Serial.print(" [WEAK]");
            if (diag.magnet_too_strong) Serial.print(" [STRONG]");
        } else {
            Serial.print("NONE (MD=0)");
        }
        Serial.print(" | AGC: ");
        Serial.print(diag.agc);
        Serial.print(" | Raw: ");
        Serial.print(diag.raw_angle);
        Serial.print(" (");
        Serial.print(diag.raw_angle_deg, 1);
        Serial.print(" deg) | FOC: ");
        Serial.print(foc_deg, 1);
        Serial.println(" deg");
    } else {
        // Alternate Test: Hardware Wire on PB6 (Pad 1 SCL) and PB7 (Pad 2 SDA)
        Wire.end();
        Wire.setSCL(PB6);
        Wire.setSDA(PB7);
        Wire.setClock(400000);
        Wire.begin();

        Wire.beginTransmission(0x36);
        byte err_pb6 = Wire.endTransmission();

        if (err_pb6 == 0) {
            AS5600Diagnostics diag = readAS5600();
            Serial.print("[PB6 SCL / PB7 SDA OK] Found AS5600 on Pad 1! Raw: ");
            Serial.print(diag.raw_angle);
            Serial.print(" (");
            Serial.print(diag.raw_angle_deg, 1);
            Serial.println(" deg)");
        } else {
            Serial.print("[NO ACK at 0x36] PB8 Err: ");
            Serial.print(err_pb8);
            Serial.print(" | PB6 Err: ");
            Serial.print(err_pb6);

            pinMode(PB7, INPUT_PULLUP);
            pinMode(PB8, INPUT_PULLUP);
            pinMode(PB6, INPUT_PULLUP);
            delayMicroseconds(20);
            Serial.print(" | Idle Lines -> SDA(PB7): ");
            Serial.print(digitalRead(PB7) ? "HIGH" : "LOW");
            Serial.print(" | SCL(PB8): ");
            Serial.print(digitalRead(PB8) ? "HIGH" : "LOW");
            Serial.print(" | SCL(PB6): ");
            Serial.println(digitalRead(PB6) ? "HIGH" : "LOW");
        }
    }

    digitalToggle(LED_BUILTIN);
    delay(500);
}
