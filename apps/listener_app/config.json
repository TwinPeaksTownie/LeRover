{
  "name": "listener_app",
  "title": "Ephemeral Voice Listener",
  "description": "Offline Hotword Detection & Voice Execution Listener",
  "version": "1.0.0",
  "icon": "👂",
  "tags": ["voice", "hotword", "kws", "listener", "offline"],
  "hotword": {
    "chunk_samples": 1280,
    "sample_rate": 16000,
    "energy_multiplier": 3.0
  },
  "asr": {
    "engine": "faster_whisper",
    "model_size": "base.en",
    "language": "en"
  },
  "vad": {
    "settle_delay_sec": 3.0,
    "silence_timeout_sec": 1.2,
    "max_record_sec": 6.0,
    "min_record_sec": 0.5,
    "energy_threshold": 300
  },
  "chimes": {
    "app_start": "ornith_listen_start",
    "wake": "ornith_listen_start",
    "commit": "ornith_commit_speech",
    "cancel": "ornith_abort_recording",
    "exit": "app_exit_idle"
  },
  "network": {
    "pi4b_port": 8082,
    "mac_port": 8086
  }
}
