{
  "name": "listener_app",
  "title": "Ephemeral Voice Listener",
  "description": "Offline Hotword Detection & Voice Execution Listener",
  "version": "1.0.0",
  "icon": "👂",
  "tags": ["voice", "hotword", "kws", "listener", "offline"],
  "execution": {
    "single_turn": true
  },
  "hotword": {
    "chunk_samples": 1280,
    "sample_rate": 16000,
    "energy_multiplier": 3.0
  },
  "asr": {
    "engine": "vosk",
    "server_url": "ws://127.0.0.1:2700",
    "health_url": "http://127.0.0.1:8059/health",
    "timeout_sec": 20.0,
    "use_dynamic_grammar": false
  },
  "vad": {
    "settle_delay_sec": 2.5,
    "post_chime_settle_sec": 1.5,
    "silence_timeout_sec": 2.5,
    "max_record_sec": 10.0,
    "min_record_sec": 0.5,
    "energy_threshold": 450,
    "pre_roll_chunks": 15,
    "fuzzy_match_threshold": 0.55
  },
  "chimes": {
    "app_start": "ornith_listen_start",
    "wake": "ornith_listen_start",
    "commit": "ornith_commit_speech",
    "cancel": "ornith_abort_recording",
    "exit": "app_exit_idle"
  },
  "feedback": {
    "unmatched_action": "No action taken",
    "idle_action": "Awaiting voice command",
    "idle_transcript": "(none)"
  },
  "motion": {
    "interpolation_duration_sec": 1.2,
    "interpolation_steps": 35,
    "dead_posture": "arch"
  },
  "network": {
    "pi4b_port": 8082,
    "mac_port": 8086,
    "vosk_server_port": 8059,
    "vosk_websocket_port": 2700
  }
}
