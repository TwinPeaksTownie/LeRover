{
  "name": "joycon_teleop_app",
  "title": "Joy-Con Teleop",
  "description": "Nintendo Switch Right Joy-Con teleoperation for Overlander-4 rover and aux actuators",
  "version": "2.0.0",
  "icon": "🎮",
  "tags": ["teleop", "joycon", "rover", "aux"],
  "hardware": {
    "vendor_id": 1406,
    "product_ids": {
      "joycon_r": 8199
    },
    "mac_address": "5C:52:1E:1C:53:82",
    "poll_rate_hz": 60,
    "packet_timeout_sec": 4.0,
    "reconnect_delay_sec": 1.0,
    "init_step_delay_sec": 0.05
  },
  "pairing": {
    "timeout_sec": 45,
    "scan_timeout_sec": 10,
    "auto_remove_stale": true,
    "stale_purge_on_startup": true,
    "auto_pair_on_search": true,
    "search_scan_interval_sec": 5.0,
    "unpaired_grace_period_sec": 8.0
  },
  "control": {
    "deadzone": 0.12,
    "speed_step_pct": 5,
    "speed_step_cooldown_sec": 0.25,
    "auto_zero_samples": 30,
    "gantry_step_ticks": 500,
    "aux_lock_duration_sec": 0.6
  },
  "imu": {
    "accel_scale_g": 4096.0,
    "gyro_scale_dps": 16.4,
    "gyro_deadband_dps": 1.2,
    "stationary_motion_threshold_g": 0.05
  },
  "gestures": {
    "a_hold_sec": 2.0,
    "b_hold_sec": 2.0,
    "b_double_tap_sec": 0.40,
    "arm_drivetrain_sec": 2.0,
    "chord_abort_sec": 1.0,
    "chord_click_suppress_sec": 0.5
  },
  "chimes": {
    "app_start": "app_start",
    "device_connect": "device_connect",
    "disconnect": "disconnect",
    "arm_rover": "rover_arm_drivetrain",
    "mode_switch_rover": "mode_switch_rover",
    "mode_switch_aux": "mode_switch_aux",
    "speed_up": "correct",
    "speed_down": "incorrect",
    "chord_abort": "ornith_abort_recording",
    "app_exit_idle": "app_exit_idle"
  }
}
