{
  "name": "piranha_pose_app",
  "title": "Piranha Pose",
  "description": "Multi-mode preset teaching, sequence execution, and acoustic clack control",
  "version": "2.0.0",
  "modes": ["normal", "demo", "angry", "dance"],
  "default_mode": "normal",
  "require_active_app_for_motion": true,
  "icon": "🪴",
  "tags": ["teaching", "pose", "sequence", "audio", "so101"],
  "chimes": {
    "app_start": "app_start"
  },
  "clack_detector": {
    "enabled": true,
    "allow_acoustic_locomotion": false,
    "acoustic_attack_enabled": true,
    "startup_discard_chunks": 3,
    "peak_threshold": 3500,
    "tap_window_sec": 0.85,
    "refractory_ms": 300,
    "min_spectral_ratio": 5.0,
    "min_high_energy_pct": 50.0,
    "auto_stop_on_app_exit": true
  }
}
