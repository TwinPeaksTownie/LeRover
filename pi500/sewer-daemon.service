[Unit]
Description=Sewer Master Daemon (SO-101 Motion Controller & API Host)
After=network-online.target sound.target multi-user.target
Wants=network-online.target sound.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/so101/pi500
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
SupplementaryGroups=audio video dialout gpio i2c spi input render
ExecStart=/home/user/so101/.venv/bin/python -u /home/user/so101/pi500/main.py
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
